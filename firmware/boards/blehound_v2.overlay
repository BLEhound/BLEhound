/*
 * Overlay layer for the revised board (V2) on top of the first-batch board overlay -- it only changes the inter-chip SPIM00 pins.
 * Usage: pass it to west **together with** blehound.overlay (that one first, this file after to override):
 *   -DEXTRA_DTC_OVERLAY_FILE="boards/blehound.overlay;boards/blehound_v2.overlay"
 *   or tools/build.sh V2=1.
 *
 * The datasheet fixes SPIM00's pins as P2.01=SCK (the only clock pin on P2), P2.02=SDO, P2.04=SDI, P2.05=CSN;
 * the 0908/first-batch board putting SCK on P2.02 and MOSI on P2.03 does not comply. The revised board PCB is wired to the dedicated pins.
 *
 * WARNING the first-batch flywire board **cannot** use this overlay layer: its P2.01 is the old SYNC net shared by all three chips (with the R19 pull-up), so three chips driving SCK at once would fight each other.
 *
 * FEM (nRF21540) control pins follow revised plan B (2026-09-20): the four SPI pins move to the P1 port (datasheet same-port rule + NCS requiring the PERI-domain
 * spi2x with cs on P1): CSN=P1.19, SCK=P1.24, MOSI=P1.21, MISO=P1.20 (the firmware's pure-GPIO mode never touches MISO);
 * MODE/ANTSEL move to P0.08/P0.06; P0.07 is freed. TXEN/RXEN/PDN unchanged.
 * The remaining pins (strap/SYNC/REQ/CS, etc.) are identical on both boards and reuse the first-batch board overlay.
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&spi00_default {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
			<NRF_PSEL(SPIM_MOSI, 2, 2)>,
			<NRF_PSEL(SPIM_MISO, 2, 4)>;
	};
};
&spi00_sleep {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
			<NRF_PSEL(SPIM_MOSI, 2, 2)>,
			<NRF_PSEL(SPIM_MISO, 2, 4)>;
		low-power-enable;
	};
};

/* FEM control pins (plan B). In the DK overlay fem_sck/fem_mosi are "parked" input pull-down pins, and on the revised board they are likewise only parked. */
&fem_csn {
	gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
};
&fem_sck {
	gpios = <&gpio1 24 GPIO_ACTIVE_HIGH>;
};
&fem_mosi {
	gpios = <&gpio1 21 GPIO_ACTIVE_HIGH>;
};
&fem_antsel {
	gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
};
&fem_mode {
	gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
};
