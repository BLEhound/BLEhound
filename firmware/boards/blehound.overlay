/*
 * Real-board blehound pin mapping -- overlaid on nrf54lm20dk_nrf54lm20a_cpuapp.overlay,
 * replacing the DK placeholder pins with the full board's actual balls. All three chips A/B/C share the same numbers (verified pin by pin against the blehound netlist).
 * Goes with blehound.conf (LFRC); for usage see that file's header. The FEM pins written in the DK overlay are already the real-board balls, so they are left untouched here.
 *
 * Finalized 2026-09-19: strap and SYNC all land on the 4 trace pins of the debug header (TD0..TD3), and **the first-batch board (flywire) and the revised board
 * (schematic and direct PCB connection) use the same pin table**:
 *   pin10 = TD3 = P0.04  SYNC input (gpiote30 edge capture)
 *   pin8  = TD2 = P0.03  SYNC output (open-drain drive-low, no GPIOTE attached)
 *   pin6  = TD1 = P1.09  strap1
 *   pin4  = TD0 = P1.08  strap0
 * First-batch board: pin8<->pin10 jumper + three-chip pin10 bus + strap tied to pin3 (GND); revised board: the same connections are made by PCB routing.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/*
 * strap (finalized 2026-09-19): first-batch board fly-wired to the debug header's trace pins (see hardware/v1/README.md, "Flying-wire rework").
 *   strap0 = TD0 = P1.08 (header pin4); strap1 = TD1 = P1.09 (header pin6). Both pins are right next to GND (pin3), so the jumpers are short.
 *   Input + pull-up: tie to this header's GND (pin3) reads 0, tie to 3V3 (pin1) reads 1 (floating also reads 1 via the internal pull-up, but both the first-batch flywire and the revised board PCB
 *   explicitly tie to 3V3, not relying on floating). code=(strap1<<1)|strap0, matching the board_role.c table. Three-chip wiring:
 *     J3/U1 (A, code 00 -> guard 37): pin4->GND and pin6->GND
 *     J6/U2 (B, code 10 -> guard 38): pin4->GND, pin6->3V3
 *     J9/U3 (C, code 01 -> guard 39): pin6->GND, pin4->3V3
 * WARNING when not fly-wired, both pins read 1 (=11 reserved combination), board_role falls back to id=0 guarding 37, so all three guard 37 (degenerates to single-chip, still captures).
 * The old hard-soldered P1.03/P1.04 wiring was inconsistent with the board_role encoding (A/C collide), is deprecated, and is no longer referenced.
 */
&strap0 {
	gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
};
&strap1 {
	gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
};

/* ACT LED: P1.05 -> R -> green LED -> GND, lit on high. The DK's led0 is on P1.22, which the QFN52 does not break out. */
&led0 {
	gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
};

/*
 * SYNC (finalized 2026-09-19: two-pin scheme, the two pins are adjacent for easy jumpering):
 *   input  sync_in  = P0.04 = TD3 = header pin10 (gpio0/gpiote30, edge-interrupt capture for a shared time base)
 *   output sync_out = P0.03 = TD2 = header pin8  (open-drain drive-low, released normally; this pin **must not** have any GPIOTE attached)
 *   flywire: on each of J3/J6/J9 one short jumper pin8<->pin10 (two adjacent pins); across the three chips pin10 is interconnected into a bus (J3.10-J6.10-J9.10).
 *   No external pull-up; sync_in enables the internal pull-up (three in parallel ~4k; the ~1Hz low-frequency SYNC edges are fine with that).
 *
 * Why it can't be a single pin: the nRF54L GPIOTE differs from the nRF52 -- per the datasheet's GPIOTE chapter, as soon as a channel's IN event
 *   is configured on pin n, that pin's output value is updated only by GPIOTE and any write from the GPIO side is ignored; MODE=Disabled does not
 *   truly disconnect it either. Observed on real hardware 2026-09-19: a pin that had had an IN interrupt attached (tried both P0.04 and P1.08) stayed
 *   permanently high on its pad after push-pull drive-low, while an identical pin that had never had an interrupt attached pulled low normally. So the
 *   capture pin and the drive pin must be separate, joined into one line by an external jumper.
 */
&sync_in {
	gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};
&sync_out {
	gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
};

/*
 * Inter-chip link (per chip: downstream master port SPIM + upstream slave port SPIS + two REQ lines):
 *   downstream master port spi00: SCK=P2.02 MOSI=P2.03 MISO=P2.04, CS=P2.05 (GPIO, attached to spi_config at runtime by peer_link).
 *   REQ_IN (the downstream slave calling me) = P1.29; REQ_OUT (me calling the upstream master) = P1.02.
 *   The upstream slave port SPIS (P1.30/P1.31/P1.00/P1.01) is board bring-up work; peer_link does not load SPIS yet, so it is not claimed here.
 * The DK's spi00 SCK is on P2.01 -- on the real board that is the SYNC line, and not changing it would hold SYNC permanently low, so pinctrl must remap it.
 */
&peer_cs {
	gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
};
&req_in {
	gpios = <&gpio1 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};
&req_out {
	gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
};

&spi00_default {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 2, 2)>,
			<NRF_PSEL(SPIM_MOSI, 2, 3)>,
			<NRF_PSEL(SPIM_MISO, 2, 4)>;
	};
};
&spi00_sleep {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 2, 2)>,
			<NRF_PSEL(SPIM_MOSI, 2, 3)>,
			<NRF_PSEL(SPIM_MISO, 2, 4)>;
		low-power-enable;
	};
};
