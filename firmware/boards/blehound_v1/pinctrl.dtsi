/*
 * Inter-chip SPIM00 (downstream master port) pins.
 * V1 (first-batch board, 0908): SCK=P2.02 MOSI=P2.03 MISO=P2.04. This does not follow the datasheet's dedicated
 * SPIM00 pins (P2.01 is the old SYNC net shared by all three chips, with the R19 pull-up) -- fixed on V2.
 */
&pinctrl {
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 2)>,
				<NRF_PSEL(SPIM_MOSI, 2, 3)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 2)>,
				<NRF_PSEL(SPIM_MOSI, 2, 3)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			low-power-enable;
		};
	};
};
