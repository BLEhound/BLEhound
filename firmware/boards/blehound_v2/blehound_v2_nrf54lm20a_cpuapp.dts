/*
 * BLEhound board definition, derived from the Zephyr nRF54LM20 DK board
 * (boards/nordic/nrf54lm20dk, Copyright (c) 2025 Nordic Semiconductor ASA).
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;

#include <nordic/nrf54lm20a_cpuapp.dtsi>
#include "../common/blehound_nrf54lm20a_cpuapp_common.dtsi"
#include "pinctrl.dtsi"

/ {
	compatible = "blehound,blehound-v2-nrf54lm20a-cpuapp";
	model = "BLEhound V2 nRF54LM20A Application MCU";

	chosen {
		zephyr,code-partition = &slot0_partition;
		zephyr,sram = &cpuapp_sram;
	};

	/*
	 * nRF21540 FEM control port (one per chip, pure GPIO, no SPI; for the rules see src/fem_ctrl.h).
	 * V2 (revised board, plan B 2026-09-20): the four FEM SPI pins moved to the P1 port (datasheet same-port rule + NCS
	 * requiring the PERI-domain spi2x with cs on P1): CSN=P1.19 SCK=P1.24 MOSI=P1.21 (MISO=P1.20, never touched in
	 * pure-GPIO mode); MODE/ANTSEL moved to P0.08/P0.06, P0.07 freed. PDN=P1.18 RX_EN=P1.16 TX_EN=P1.15 unchanged.
	 * SCK/MOSI are only parked (input pull-down) by fem_ctrl.
	 */
	tri_fem {
		compatible = "gpio-keys";
		fem_pdn: fem_pdn {
			gpios = <&gpio1 18 GPIO_ACTIVE_HIGH>;
			zephyr,code = <8>;
		};
		fem_rxen: fem_rxen {
			gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;
			zephyr,code = <9>;
		};
		fem_txen: fem_txen {
			gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
			zephyr,code = <10>;
		};
		fem_antsel: fem_antsel {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			zephyr,code = <11>;
		};
		fem_mode: fem_mode {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
			zephyr,code = <12>;
		};
		/* Chip select is active low: fem_ctrl configures OUTPUT_INACTIVE = physical high = never selected. */
		fem_csn: fem_csn {
			gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
			zephyr,code = <13>;
		};
		fem_sck: fem_sck {
			gpios = <&gpio1 24 GPIO_ACTIVE_HIGH>;
			zephyr,code = <14>;
		};
		fem_mosi: fem_mosi {
			gpios = <&gpio1 21 GPIO_ACTIVE_HIGH>;
			zephyr,code = <15>;
		};
	};

	/*
	 * Inter-chip upstream slave port (SPIS, PERI domain instance spi21; for the link topology see src/peer_link.h).
	 * peer_link drives it through nrfx_spis directly (the pins are taken from these gpio-keys entries and handed to
	 * nrfx, the spi21 node itself stays disabled so Zephyr's SPIS driver does not claim it).
	 * V2 (revised board): SCK moved to the clock pin P1.03; MOSI=P1.31 MISO=P1.00 CSN=P1.01 unchanged.
	 */
	tri_peer_spis {
		compatible = "gpio-keys";
		peer_spis_sck: peer_spis_sck {
			gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
			zephyr,code = <16>;
		};
		peer_spis_mosi: peer_spis_mosi {
			gpios = <&gpio1 31 GPIO_ACTIVE_HIGH>;
			zephyr,code = <17>;
		};
		peer_spis_miso: peer_spis_miso {
			gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
			zephyr,code = <18>;
		};
		peer_spis_csn: peer_spis_csn {
			gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
			zephyr,code = <19>;
		};
	};

	/*
	 * Inter-chip downstream master port pins (software SPI master in peer_link; see the common dtsi for why).
	 * V2 (revised board): SCK=P2.01 MOSI=P2.02 MISO=P2.04 (bit-banged for now; P2.01 is the SPIM00 clock pin, hardware SPIM00 possible later).
	 */
	tri_peer_spim {
		compatible = "gpio-keys";
		peer_spim_sck: peer_spim_sck {
			gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>;
			zephyr,code = <20>;
		};
		peer_spim_mosi: peer_spim_mosi {
			gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>;
			zephyr,code = <21>;
		};
		peer_spim_miso: peer_spim_miso {
			gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
			zephyr,code = <22>;
		};
	};

	aliases {
		tri-spis-sck = &peer_spis_sck;
		tri-spis-mosi = &peer_spis_mosi;
		tri-spis-miso = &peer_spis_miso;
		tri-spis-csn = &peer_spis_csn;
		tri-spim-sck = &peer_spim_sck;
		tri-spim-mosi = &peer_spim_mosi;
		tri-spim-miso = &peer_spim_miso;
	};
};

/* Upstream slave port instance: SPIS binding so nrfx's SPIS driver is selectable, kept disabled on purpose. */
&spi21 {
	compatible = "nordic,nrf-spis";
	/delete-property/ rx-delay-supported;
	/delete-property/ rx-delay;
	def-char = <0>;
	status = "disabled";
};

/* Default memory partition table, then the DFU layout on top of it (MCUboot + firmware loader + app). */
#include <vendor/nordic/nrf54lm20a_cpuapp_partition.dtsi>
#include "../common/blehound_partitions.dtsi"
