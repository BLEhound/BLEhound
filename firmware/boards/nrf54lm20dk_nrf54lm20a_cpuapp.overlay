/*
 * Firmware pin definitions for the in-house full board blehound (3x nRF54LM20A) -- overlaid on the DK target.
 *
 * NOTE: this overlay targets the nRF54LM20 DK and uses DK GPIOs as **placeholders** so the firmware
 *   compiles/links on the DK. The real-board ball map (finalized) lives in boards/blehound.overlay,
 *   which is layered on top of this file and overrides these pins with the actual board balls.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/*
 * CDC ACM data channel. WARNING note: when a board-level overlay exists, Zephyr **no longer auto-applies app.overlay**,
 * so the CDC ACM node from app.overlay must be redefined here, otherwise host_iface.c's
 * DEVICE_DT_GET_ONE(zephyr_cdc_acm_uart) fails at compile time (no okay CDC node found).
 */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/ {
	/*
	 * strap: 2 GPIOs encoding board_id and the advertising channel guarded (design §4.5).
	 * On the full board each chip has one set hard-soldered (to GND / pull-up); for how it is read see firmware/src/board_role.c.
	 * WARNING board bring-up: placeholders use the DK's gpio1 2/3 (Arduino header pins).
	 */
	tri_straps {
		compatible = "gpio-keys";
		strap0: strap_0 {
			gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
			zephyr,code = <1>;
		};
		strap1: strap_1 {
			gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
			zephyr,code = <2>;
		};
	};

	/*
	 * SYNC sync line (design §5.2): on the full board it is **one** open-drain line shared by all three chips + a 4.7k pull-up.
	 * The DK has no such net, so use two GPIOs as placeholders (merged into one line on the board; for DK regression, jumper the two pins together).
	 * WARNING board bring-up: placeholders use the DK's gpio1 4 (in) / gpio1 5 (out).
	 */
	tri_sync {
		compatible = "gpio-keys";
		sync_in: sync_in {
			gpios = <&gpio1 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <3>;
		};
		sync_out: sync_out {
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
			zephyr,code = <4>;
		};
	};

	/*
	 * The inter-chip link's CS and two REQ lines (design §4.2). The inter-chip SPI bus itself uses the tri-peer-spi alias
	 * pointing to a SPIM (placeholder to spi00 on the DK so it compiles/links; a dedicated SPIM instance on the full board).
	 * WARNING board bring-up: CS/REQ placeholders use the DK's gpio1 10/11/12.
	 */
	tri_peer {
		compatible = "gpio-keys";
		peer_cs: peer_cs {
			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			zephyr,code = <5>;
		};
		req_in: req_in {
			gpios = <&gpio1 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <6>;
		};
		req_out: req_out {
			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
			zephyr,code = <7>;
		};
	};

	/*
	 * nRF21540 FEM control port (one per chip, pure GPIO, no SPI; for the rules see src/fem_ctrl.h).
	 * This group is the full board's **actual balls** (all three chips A/B/C share the same numbers, verified against the blehound netlist), not placeholders:
	 *   PDN=P1.18 RX_EN=P1.16 TX_EN=P1.15 ANT_SEL=P1.19 MODE=P1.20 CSN=P0.06 SCK=P0.07 MOSI=P0.08
	 *   MISO=P0.09 **deliberately omitted** -- on some early samples this pin is tied to VDD inside the package, so the firmware never touches it.
	 *   WARNING the above are the 0908 first-batch board balls. The revised board (V2) has moved the FEM SPI to the P1 port (CSN=P1.19 SCK=P1.24 MOSI=P1.21
	 *   MISO=P1.20, MODE/ANTSEL moved to P0.08/P0.06), overridden by boards/blehound_v2.overlay.
	 * DK regression: the DK has no FEM, so these pins are empty header/VCOM lines and driving them is harmless. On the DK, P0.07 is the uart30 RX
	 * direction (driven by the IMCU on the other side), so fem_ctrl only configures SCK/MOSI as input pull-down and does not drive them; P1.16 is the DK's
	 * uart20 TX, and uart20 is disabled at the end of this file to free it.
	 */
	tri_fem {
		compatible = "gpio-keys";
		fem_pdn: fem_pdn {
			gpios = <&gpio1 18 GPIO_ACTIVE_HIGH>;
			zephyr,code = <8>;
		};
		fem_rxen: fem_rxen {
			gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;
			zephyr,code = <9>;
		};
		fem_txen: fem_txen {
			gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
			zephyr,code = <10>;
		};
		fem_antsel: fem_antsel {
			gpios = <&gpio1 19 GPIO_ACTIVE_HIGH>;
			zephyr,code = <11>;
		};
		fem_mode: fem_mode {
			gpios = <&gpio1 20 GPIO_ACTIVE_HIGH>;
			zephyr,code = <12>;
		};
		/* Chip select is active low: fem_ctrl configures OUTPUT_INACTIVE = physical high = never selected. */
		fem_csn: fem_csn {
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			zephyr,code = <13>;
		};
		fem_sck: fem_sck {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			zephyr,code = <14>;
		};
		fem_mosi: fem_mosi {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
			zephyr,code = <15>;
		};
	};

	aliases {
		tri-strap0 = &strap0;
		tri-strap1 = &strap1;
		tri-sync-in = &sync_in;
		tri-sync-out = &sync_out;
		tri-peer-cs = &peer_cs;
		tri-req-in = &req_in;
		tri-req-out = &req_out;
		/* Inter-chip SPI master-port bus. WARNING board bring-up: the DK placeholder uses spi00 (its flash sub-device is already disabled),
		 * on the full board this is re-pointed to a dedicated SPIM instance. */
		tri-peer-spi = &spi00;
		fem-pdn = &fem_pdn;
		fem-rxen = &fem_rxen;
		fem-txen = &fem_txen;
		fem-antsel = &fem_antsel;
		fem-mode = &fem_mode;
		fem-csn = &fem_csn;
		fem-sck = &fem_sck;
		fem-mosi = &fem_mosi;
	};
};

/*
 * uart20 (P1.16/P1.17) is the DK's VCOM console. This firmware's console uses RTT (prj.conf CONFIG_UART_CONSOLE=n),
 * so disable it to free P1.16 for the FEM's RX_EN, otherwise the uart driver's pinctrl and the GPIO config override each other.
 */
&uart20 {
	status = "disabled";
};
