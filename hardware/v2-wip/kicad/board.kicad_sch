	(text "USB port protection (per nRF54LM20-DK): data lines go through PRTR5V0U2F ESD -> common-mode choke -> hub; VBUS enters +5V via a ferrite bead, connector side has 1uF+100nF+SMAJ5.0A TVS; CC1/CC2 each get one PESD5V0S1BA." (exclude_from_sim no) (at 20 210 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "020be53b-7fb6-40d2-8f5a-a7a55bb04a30"))
	(embedded_fonts no)
